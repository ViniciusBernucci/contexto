  "cards": [
    {
      "dot": "cyan",
      "title": "Configuração por projeto",
      "items": [
        "Regras locais e workflow definem caminhos e convenções",
        "Uma especificação; prompts e relatórios por referência",
        "Contexto mantém estado, busca e logs sem aprovar por conta própria",
        "Cada worktree herda configuração e cria seu próprio banco"
      ]
    },
    {
      "dot": "amber",
      "title": "Gates proporcionais",
      "items": [
        "Simples: QA pode ser coberto pelo review independente com evidência completa",
        "Padrão: QA independente; auditoria se houver achados",
        "Crítico: auditoria mesmo sem achados e QA independente",
        "Sem critério essencial demonstrado não existe aprovação"
      ]
    },
    {
      "dot": "rose",
      "title": "Proteções preservadas",
      "items": [
        "Limite de três rodadas técnicas e três de QA por tarefa",
        "Bloqueio isola dependentes; tarefas independentes continuam",
        "Git de escrita em main, push e PR não são automáticos",
        "Métricas locais e comparação de contadores; economia total exige baseline equivalente"
      ]
    }
  ]
